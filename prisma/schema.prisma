generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tattoo {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  category    String?
  imagePath   String
  basePrice   Decimal? @db.Decimal(10, 2)
  currency    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id            String    @id @default(cuid())
  reference     String    @unique
  serviceType   String
  tattooSlug    String?
  customIdea    String?
  customerName  String
  email         String
  phone         String
  whatsapp      String?
  country       String
  city          String
  address       String?
  appointmentAt DateTime
  notes         String?
  totalAmount   Decimal   @db.Decimal(10, 2)
  travelFee     Decimal?  @db.Decimal(10, 2)
  currency      String
  depositAmount Decimal   @db.Decimal(10, 2)
  balanceAmount Decimal   @db.Decimal(10, 2)
  status        String    @default("AWAITING_PAYMENT")
  receiptToken  String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payment Payment?
}

model Payment {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id])
  txRef             String    @unique
  flwTransactionId  String?   @unique
  amount            Decimal   @db.Decimal(10, 2)
  currency          String
  status            String    @default("PENDING")
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  webhookEvents WebhookEvent[]
}

model WebhookEvent {
  id        String   @id @default(cuid())
  hash      String   @unique
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  payload   Json
  createdAt DateTime @default(now())
}

model CustomRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  idea         String
  size         String?
  placement    String?
  style        String?
  refImagePath String?
  serviceType  String
  country      String
  city         String
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
}

model SiteSetting {
  id          String   @id @default("main")
  videoUrl    String?
  reviewsJson Json?
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  location  String?
  rating    Int
  text      String
  isVisible Boolean  @default(false)
  createdAt DateTime @default(now())
}